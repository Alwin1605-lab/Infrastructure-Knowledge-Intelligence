# =========================================
#  Building Knowledge Intelligence
#  Environment Configuration
# =========================================
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# =========================================

# --- Application ---
APP_NAME=BuildingKnowledgeIntelligence
APP_ENV=development                        # Options: development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- LLM Provider (Text Generation) ---
LLM_PROVIDER=groq                         # Options: groq | ollama

# --- Groq (Default Provider) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant           # Free tier default
# GROQ_MODEL=llama-3.3-70b-versatile      # Higher quality (free tier)
GROQ_MAX_RETRIES=3
GROQ_RETRY_DELAY=1.0
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=4096

# --- Ollama (Fallback / Offline) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Embedding (Always Local HuggingFace) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2          # ~90MB, auto-downloads on first use
EMBEDDING_DEVICE=cpu                       # Options: cpu | cuda

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=building_knowledge

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- ChromaDB ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=building_documents

# --- RAG Configuration ---
RAG_TOP_K=5                               # Number of chunks to retrieve
RAG_SIMILARITY_THRESHOLD=0.7              # Minimum relevance score
RAG_CHUNK_SIZE=1000                        # Chunk size in characters
RAG_CHUNK_OVERLAP=200                      # Overlap between chunks

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
