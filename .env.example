# =========================================
#  Building Knowledge Intelligence System
#  Environment Configuration Template
# =========================================

# --- Application ---
APP_NAME=InfraKnowledgeIntelligence
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Processing Limits & Timeouts ---
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=3600
KG_BATCH_SIZE_PAGES=5
MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=120

# --- LLM Provider & Multi-Key Rotation ---
LLM_PROVIDER=groq
GROQ_API_KEY=your_primary_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_1=your_secondary_groq_api_key_here
GROQ_2=your_tertiary_groq_api_key_here

# --- Fallback LLM Provider ---
GEMINI_1=your_gemini_fallback_api_key_here

# --- Embedding ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- MongoDB (Document Store) ---
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=infra_knowledge

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- ChromaDB (Vector Store) ---
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000
CHROMADB_COLLECTION=infra_documents
CHROMADB_PATH=./chroma_data

# --- RAG ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# --- File Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# --- Frontend ---
VITE_API_BASE_URL=/api/v1

# --- Security ---
SECRET_KEY=generate_a_secure_random_jwt_secret_key_here
